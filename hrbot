class CustomFilter(logging.Filter):
    def filter(self, record):
        return record.levelno in [logging.WARNING, logging.ERROR]

class ConnectionErrorFilter(logging.Filter):
    def filter(self, record):
        msg = str(record.msg)
        if "Cannot write to closing transport" in msg:
            return False
        if "ConnectionResetError" in msg:
            return False
        if "ClientConnectionResetError" in msg:
            return False
        return True

logging.basicConfig(
