def parse_pay(text):
    text = text.replace("!pay", "", 1).strip()
    parts = text.split()
    if len(parts) < 2:
        return None, None, None
    
    amount_unit = parts[0]
    bot_name = " ".join(parts[1:])
    
    if amount_unit.lower() == "f":
        return 1, "f", bot_name
    
    num_str = ""
    unit = ""
    for ch in amount_unit:
        if ch.isdigit() or ch == '.':
            num_str += ch
        else:
            unit += ch.lower()
    
    if not num_str:
        if unit and unit in COST_PER_UNIT:
            num_str = ""
            for ch in amount_unit:
                if ch.isdigit() or ch == '.':
                    num_str += ch
            if not num_str:
                num_str = "1"
    
    try:
        amount = float(num_str)
    except:
        amount = 1
    
    if not unit:
        unit = "h"
    
    if unit not in COST_PER_UNIT:
        return None, None, None
    
    return amount, unit, bot_name

