    async def on_disconnect(self):
        logger.warning("اتصال ربات اصلی قطع شد. تلاش برای reconnect...")
        if self.restart_check_task:
            self.restart_check_task.cancel()
        for bot_name, task in list(self.active_bots.items()):
            task.cancel()
        self.active_bots.clear()


