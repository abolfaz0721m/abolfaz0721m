    async def cmd_emote_bot(self, user: User, message: str):
        if self.bot_type == "game":
            return
        
        if self.is_bot_expired_for_user(user):
            if not self.check_permission(user.username, user.id):
                try:
                    await self.highrise.send_whisper(user.id, self.get_message("expired_whisper"))
                except:
                    await self.highrise.chat(f"@{user.username} " + self.get_message("expired_whisper"))
                return
        
        if self.blackjack_game.game_in_progress:
            return
        
        parts = message.split()
        
        if len(parts) < 3:
            await self.highrise.chat(self.get_message("emote_invalid"))
            return
        
        dance_input = " ".join(parts[2:])
        
        dance_id = extract_dance_id_from_link(dance_input)
        
        if dance_id:
            dance_name = dance_id
            dance_emote_id = dance_id
            await self.highrise.chat(f"🎵 دریافت دنس از لینک: {dance_id}")
        else:
            dance_name = dance_input.lower()
            if dance_name not in self.emotes:
                similar_dances = [d for d in self.emotes.keys() if dance_name in d.lower() or d.lower() in dance_name]
                if similar_dances:
                    await self.highrise.chat(self.get_message("emote_similar", dance_name=dance_name, similar=', '.join(similar_dances[:5])))
                else:
                    await self.highrise.chat(self.get_message("emote_not_found", dance_name=dance_name))
                return
            dance_emote_id = self.emotes[dance_name]
        
        if not self.user_id:
            await self.highrise.chat("❌ شناسه ربات یافت نشد! در حال تلاش برای دریافت...")
            try:
                room_users = await self.highrise.get_room_users()
                if hasattr(room_users, 'content'):
                    for user_data in room_users.content:
                        if user_data[0].username == self.bot_name or "bot" in user_data[0].username.lower():
                            self.user_id = user_data[0].id
                            await self.highrise.chat(f"✅ شناسه ربات دریافت شد: {self.user_id}")
                            break
            except Exception as e:
                await self.highrise.chat(f"❌ خطا در دریافت شناسه ربات: {str(e)}")
                return
        
        if self.user_id in self.dance_tasks:
            self.dance_tasks[self.user_id].cancel()
            self.dance_tasks.pop(self.user_id, None)
            self.user_dances.pop(self.user_id, None)
            await self.highrise.chat(f"🔄 توقف دنس قبلی...")
        
        async def bot_dance_loop():
            while True:
                try:
                    if self.user_id and self.user_id in self.active_users_by_id:
                        await self.highrise.send_emote(dance_emote_id, self.user_id)
                        await sleep(self.emote_duration)
                    else:
                        break
                except (CancelledError, asyncio.CancelledError):
                    break
                except Exception as e:
                    error_msg = str(e)
                    if "User not in room" in error_msg or "Cannot write to closing transport" in error_msg:
                        break
                    logger.error(f"خطا در حلقه دنس ربات: {e}", exc_info=True)
                    await sleep(5)
        
        task = create_task(bot_dance_loop())
        self.dance_tasks[self.user_id] = task
        self.user_dances[self.user_id] = dance_name
        
        self.config["bot_dance"] = {
            "dance_name": dance_name,
            "emote_id": dance_emote_id
        }
        self.save_config()
