def load_user_data():
    try:
        if os.path.exists(USER_DATA_FILE):
            with open(USER_DATA_FILE, 'r', encoding='utf-8') as f:
                data = json.load(f)
                if "users" not in data:
                    data["users"] = {}
                if "bot_wallets" not in data:
                    data["bot_wallets"] = {}
                return data
    except:
        pass
    return {"users": {}, "bot_wallets": {}}

def save_user_data(data):
    try:
        with open(USER_DATA_FILE, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
    except Exception as e:
        logger.error(f"خطا در ذخیره: {e}")

def get_user_data(user_id, data=None):
    if data is None:
        data = load_user_data()
    user_id = str(user_id)
    
    if user_id not in data["users"]:
        username = ""
        for admin_name, admin_id in MASTER_ADMINS.items():
            if user_id == admin_id:
                username = admin_name
                break
        
        data["users"][user_id] = {
            "wallet": 100000 if user_id in MASTER_ADMINS.values() else 0,
            "free_used": False,
            "bots": {},
            "username": username,
            "welcome_sent": False
        }
        save_user_data(data)
    
    if user_id in MASTER_ADMINS.values():
        for admin_name, admin_id in MASTER_ADMINS.items():
            if user_id == admin_id:
                data["users"][user_id]["username"] = admin_name
                break
        data["users"][user_id]["wallet"] = 100000
    
    defaults = {
        "wallet": 0,
        "free_used": False,
        "bots": {},
        "username": "",
        "welcome_sent": False
    }
    for field, default in defaults.items():
        if field not in data["users"][user_id]:
            data["users"][user_id][field] = default
    
    return data["users"][user_id]

