def extract_dance_id_from_link(url: str) -> str:
    """استخراج id دنس از لینک high.rs"""
    try:
        from urllib.parse import urlparse, parse_qs
        
        if not url.startswith("http"):
            url = "https://" + url
        
        parsed = urlparse(url)
        
        if parsed.netloc not in ["high.rs", "www.high.rs"]:
            return None
        if parsed.path != "/item":
            return None
        
        params = parse_qs(parsed.query)
        
        if params.get("type", [""])[0] != "emote":
            return None
        
        dance_id = params.get("id", [""])[0]
        if not dance_id:
            return None
        
        return dance_id
    except:
        return None

def format_time_ago(timestamp):
    diff = time() - timestamp
    if diff < 0:
        return "همین الان"
    
    days = int(diff // 86400)
    hours = int((diff % 86400) // 3600)
    minutes = int((diff % 3600) // 60)
    
    if days > 0:
        return f"{days} روز و {hours} ساعت پیش"
    elif hours > 0:
        return f"{hours} ساعت و {minutes} دقیقه پیش"
    else:
        return f"{minutes} دقیقه پیش"

def format_remaining(expiry):
    if expiry == float('inf'):
        return "♾ نامحدود (برای همیشه)"
    
    remaining = expiry - time()
    if remaining <= 0:
        return "❌ به پایان رسیده"
    
    days = int(remaining // 86400)
    hours = int((remaining % 86400) // 3600)
    minutes = int((remaining % 3600) // 60)
    seconds = int(remaining % 60)
    
    if days > 0:
        return f"{days} روز و {hours} ساعت و {minutes} دقیقه"
    elif hours > 0:
        return f"{hours} ساعت و {minutes} دقیقه و {seconds} ثانیه"
    elif minutes > 0:
        return f"{minutes} دقیقه و {seconds} ثانیه"
    else:
        return f"{seconds} ثانیه"

def format_elapsed(created_at):
    elapsed = time() - created_at
    days = int(elapsed // 86400)
    hours = int((elapsed % 86400) // 3600)
    minutes = int((elapsed % 3600) // 60)
    
    if days > 0:
        return f"{days} روز و {hours} ساعت"
    elif hours > 0:
        return f"{hours} ساعت و {minutes} دقیقه"
    else:
        return f"{minutes} دقیقه"


