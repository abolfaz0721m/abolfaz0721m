    def load_config(self):
        config_file = f"bot_config_{self.bot_name}.json" if self.bot_name else CONFIG_FILE
        try:
            if self.bot_owner_id:
                user_dir = os.path.join("users", str(self.bot_owner_id))
                config_file = os.path.join(user_dir, f"bot_config_{self.bot_name}.json")
                os.makedirs(user_dir, exist_ok=True)
            
            os.makedirs(os.path.dirname(config_file) or '.', exist_ok=True)
            if os.path.exists(config_file) and os.access(config_file, os.R_OK):
                with open(config_file, 'r', encoding='utf-8') as f:
                    self.config = json.load(f)
                self.saved_position = self.config.get("saved_bot_position")
                self.expiry_time = self.config.get("expiry_time")
            else:
                self.config = deepcopy(DEFAULT_CONFIG)
                self.config["bot_type"] = self.bot_type
                self.saved_position = self.config.get("saved_bot_position")
                self.save_config()

            self.saved_position = self.config.get("saved_bot_position")
            self.bot_owner = self.config.get("bot_owner")
            self.bot_owner_id = self.config.get("bot_owner_id")
            self.expiry_time = self.config.get("expiry_time")
            
            self.config["bot_type"] = self.bot_type
            
            if "admin_user_ids" not in self.config:
                self.config["admin_user_ids"] = []
            for admin_id in MASTER_ADMINS.values():
                if admin_id not in self.config["admin_user_ids"]:
                    self.config["admin_user_ids"].append(admin_id)
            
            if self.bot_owner_id and self.bot_owner_id not in self.config["admin_user_ids"]:
                self.config["admin_user_ids"].append(self.bot_owner_id)
                self.save_config()
            
            if "admin_usernames" not in self.config:
                self.config["admin_usernames"] = []
            for admin_name in MASTER_ADMINS.keys():
                if admin_name not in self.config["admin_usernames"]:
                    self.config["admin_usernames"].append(admin_name)
            
            if self.bot_owner and self.bot_owner not in self.config["admin_usernames"]:
                self.config["admin_usernames"].append(self.bot_owner)
                self.save_config()

            self.config["admin_user_ids"] = [a for a in self.config["admin_user_ids"] if a]
            self.admin_user_ids = self.config["admin_user_ids"]

            if "bot_dance" not in self.config:
                self.config["bot_dance"] = None
                self.save_config()

            self.config["bot_type"] = self.bot_type
            self.save_config()

        except Exception as e:
            logger.error(f"خطا در بارگذاری تنظیمات: {e}")
            self.config = deepcopy(DEFAULT_CONFIG)
            self.config["bot_type"] = self.bot_type
            self.saved_position = self.config.get("saved_bot_position")
            self.save_config()

    def load_dynamic_teleport_commands(self):
        for loc_name in list(self.config.get("teleport_locations", {}).keys()):
            if loc_name not in ["vip", "vip1", "dj"]:
                if f"!{loc_name}" in self.commands:
                    del self.commands[f"!{loc_name}"]
        
        for location_name in list(self.config.get("teleport_locations", {}).keys()):
            if location_name not in ["vip", "vip1", "dj"]:
                def make_dynamic_teleport(loc):
                    async def dynamic_teleport(user: User, message: str):
                        if not self.check_permission(user.username, user.id):
                            await self.highrise.chat(self.get_message("no_permission"))
                            return
                        try:
                            dest = self.config["teleport_locations"][loc]
                            await self.highrise.teleport(user_id=user.id, dest=Position(x=float(dest["x"]), y=float(dest["y"]), z=float(dest["z"])))
                            await self.highrise.chat(self.get_message("teleport_success", username=user.username, location=loc.upper()))
                        except Exception as e:
                            await self.highrise.chat(self.get_message("teleport_error", error=str(e)))
                    return dynamic_teleport
                
