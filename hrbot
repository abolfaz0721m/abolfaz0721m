    async def user_update_loop(self):
        while True:
            try:
                await self.sync_room_users()
                await asyncio.sleep(1)
            except asyncio.CancelledError:
                break
            except Exception as e:
                logger.error(f"خطا در حلقه به‌روزرسانی کاربران: {e}")
                await asyncio.sleep(5)

    async def sync_room_users(self):
        try:
            room_users = await self.highrise.get_room_users()
            if not hasattr(room_users, 'content'):
                return
            
            current_users = {user_data[0].username.lower(): user_data for user_data in room_users.content}
            
            self.active_users_by_id.clear()
            for username, user_data in current_users.items():
                user_obj = user_data[0]
                self.active_users_by_id[user_obj.id] = user_obj
            
            for username in list(self.active_users.keys()):
                if username not in current_users:
                    self.active_users.pop(username, None)
                    self.user_positions.pop(username, None)
            
            for username, user_data in current_users.items():
                self.active_users[username] = user_data[0]
                position = user_data[1]
                if hasattr(position, 'x') and all(isinstance(coord, (int, float)) and coord is not None for coord in [position.x, position.y, position.z]):
                    self.user_positions[username] = position
                else:
                    self.user_positions[username] = None
                    
        except Exception as e:
            logger.error(f"خطا در همگام‌سازی کاربران: {e}")

    async def on_user_join(self, user: User, position: Position | AnchorPosition | None = None):
        username = user.username.lower()
        if username in self.config.get("banned_users", []):
            await self.highrise.kick(user.id)
            return
        
        self.active_users[username] = user
        self.active_users_by_id[user.id] = user
        if hasattr(position, 'x') and hasattr(position, 'y') and hasattr(position, 'z'):
            self.user_positions[username] = position
        else:
            self.user_positions[username] = None
        
        await self.highrise.chat(f"👋 به {user.username} خوش آمدید! برای سوال از / استفاده کنید! 😊")

    async def on_user_leave(self, user: User, position=None):
        username = user.username.lower()
        self.active_users.pop(username, None)
        self.active_users_by_id.pop(user.id, None)
        self.user_positions.pop(username, None)
        
        if str(user.id) in self.conversations:
            del self.conversations[str(user.id)]

    async def on_chat(self, user: User, message: str):
        username = user.username.lower()
        user_id = str(user.id)
        msg = message.strip()
        
        try:
            # ========== پردازش دستورات با ! ==========
            if msg.startswith("!"):
                parts = msg.split()
                cmd_key = parts[0] if parts else ""
                
                if cmd_key in self.commands:
                    await self.commands[cmd_key](user, message)
                    return
                else:
                    return
            
            # ========== بررسی پیام‌های با / (اسلش) ==========
            if not msg.startswith("/"):
                return
            
            clean_message = msg[1:].strip()
            
            if not clean_message:
                return
            
            # ========== بررسی فعال بودن AI ==========
            if not self.ai_enabled:
                await self.highrise.chat(f"@{user.username} متاسفم، سیستم هوش مصنوعی در دسترس نیست! 🙏")
                return
            
            # ========== دریافت پاسخ هوشمند ==========
            try:
                if user_id not in self.conversations:
                    self.conversations[user_id] = []
                
                self.conversations[user_id].append({
                    "role": "user",
                    "content": clean_message
                })
                
                history = self.conversations[user_id][-10:]
                
                system_prompt = f"""تو یک ربات Highrise هستی به نام {self.bot_name}.
                با کاربران به صورت دوستانه، محترمانه و با لحن گرم صحبت کن.
                پاسخ‌ها باید کوتاه (حداکثر ۳-۴ جمله)، مفید و مناسب باشند.
                کاربر فعلی: {username}
                
                قوانین مهم:
                - هرگز نگو که یک ربات یا هوش مصنوعی هستی (مگر اینکه کاربر مستقیماً بپرسد)
                - با احترام و ادب صحبت کن
                - اگر سوالی رو نمی‌دانی، بگو نمی‌دانی
                - پاسخ‌ها رو با ایموجی‌های مناسب همراه کن 😊
                """
                
                messages = [{"role": "system", "content": system_prompt}] + history
                
                response = self.ai_client.chat.completions.create(
                    model=self.ai_model,
                    messages=messages,
                    temperature=0.7,
                    max_tokens=500,
                    top_p=0.9
                )
                
                ai_response = response.choices[0].message.content
                
                self.conversations[user_id].append({
                    "role": "assistant",
                    "content": ai_response
                })
                
                await self.highrise.chat(f"@{user.username} {ai_response}")
                
            except Exception as e:
                logger.error(f"خطا در AI: {e}")
                await self.highrise.chat(f"@{user.username} متاسفم، در حال حاضر نمی‌توانم پاسخ دهم. لطفاً دوباره تلاش کن. 🙏")
                
        except Exception as e:
            logger.error(f"خطا در on_chat: {e}")

    async def cmd_help(self, user: User, message: str):
        help_text = f"""🧠 **راهنمای ربات هوشمند {self.bot_name}**

📋 **دستورات موجود:**
!help - نمایش این راهنما
!set - ذخیره موقعیت ربات

