        parts = message.lower().split()
        if len(parts) != 2 or not parts[1].startswith("@"):
            await self.highrise.chat(self.get_message("invalid_format", format="!freeze @username"))
            return
        target_username = parts[1].lstrip('@').lower()
        target_user = self.active_users.get(target_username)
        if not target_user:
            await self.highrise.chat(self.get_message("user_not_found", username=target_username))
            return
        try:
            if target_username in self.frozen_users:
                await self.highrise.chat(f"@{target_username} is already frozen!")
                return
            position = self.user_positions.get(target_username)
            if not position or not hasattr(position, 'x') or not all(isinstance(coord, (int, float)) and coord is not None for coord in [position.x, position.y, position.z]):
                await self.highrise.chat(self.get_message("teleport_error", error=f"Position for @{target_username} is unavailable or invalid"))
                return

            async def freeze_loop():
                while True:
                    try:
                        if target_username in self.frozen_users:
                            current_position = self.user_positions.get(target_username)
                            if current_position and (
                                current_position.x != position.x or
                                current_position.y != position.y or
                                current_position.z != position.z
                            ):
                                await self.highrise.teleport(user_id=target_user.id, dest=position)
                            await sleep(0.5)
                        else:
                            break
                    except CancelledError:
                        break
                    except Exception as e:
                        logger.error(f"خطا در حلقه فریز برای {target_username}: {e}", exc_info=True)
                        await sleep(5)

            task = create_task(freeze_loop())
            self.frozen_users[target_username] = (task, position)
            await self.highrise.chat(self.get_message("freeze_success", username=target_username))
        except Exception as e:
            await self.highrise.chat(self.get_message("teleport_error", error=str(e)))

