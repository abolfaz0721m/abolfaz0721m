            await self.highrise.chat(self.get_message("retry_restart", bot_name=bot_name))
            try:
                self.bot_tasks[bot_name].cancel()
                del self.bot_tasks[bot_name]
            except:
                pass
            await asyncio.sleep(1)
        
        bot_info["active"] = True
        bot_info["started_at"] = time()
        save_user_data(data)
        
        await self._launch_bot(user_id, bot_name, bot_info)
        
        remaining_str = format_remaining(expiry) if expiry is not None else "برای همیشه"
        await self.highrise.chat(f"🔄 **ربات {bot_name}** با موفقیت ری‌استارت شد!\n⏳ زمان باقیمانده: {remaining_str}")

    async def _launch_bot(self, user_id: str, bot_name: str, bot_info: dict):
        try:
            room_id = bot_info.get("room_id", "")
            api_token = bot_info.get("api_token", "")
            bot_type = bot_info.get("bot_type", "classic")
            
            if not room_id or not api_token:
                logger.error(f"❌ اطلاعات ربات {bot_name} ناقص است!")
                return
            
            advanced_bot = AdvancedBot(user_id=user_id, bot_type=bot_type)
            advanced_bot.bot_name = bot_name
            advanced_bot.load_config()
            
            advanced_bot.bot_type = bot_type
            advanced_bot.config["bot_type"] = bot_type
            advanced_bot.save_config()
            advanced_bot.load_commands_by_type()
            
            if "owner" in bot_info and bot_info["owner"]:
                advanced_bot.bot_owner = bot_info["owner"]
            if "owner_id" in bot_info and bot_info["owner_id"]:
                advanced_bot.bot_owner_id = bot_info["owner_id"]
                advanced_bot.save_config()
            
            bot_def = BotDefinition(advanced_bot, room_id, api_token)
            
            async def run_bot_with_reconnect():
                logger.info(f"🚀 شروع اجرای ربات {bot_name} با نوع {bot_type} و room_id={room_id}")
                attempt = 0
                while True:
                    try:
                        await highrise_main([bot_def])
                        logger.warning(f"⚠️ ربات {bot_name} بدون خطا قطع شد.")

                        data = load_user_data()
                        bot_info_check = data.get("users", {}).get(user_id, {}).get("bots", {}).get(bot_name)
                        if not bot_info_check or not bot_info_check.get("active"):
                            logger.warning(f"ربات {bot_name} غیرفعال شده، متوقف شد.")
                            break
                        expiry = bot_info_check.get("rental_expiry")
                        if expiry is not None and expiry != float('inf') and time() > expiry:
                            logger.warning(f"زمان ربات {bot_name} تموم شده، متوقف شد.")
                            break

                        attempt = 0
                        await asyncio.sleep(3)
                        continue

                    except RestartBotException:
                        logger.info(f"🔄 ربات {bot_name} درخواست ری‌استارت داد.")
                        attempt = 0
                        continue
                    except Exception as e:
                        logger.error(f"❌ ربات {bot_name} با خطا متوقف شد: {e}", exc_info=True)
                        attempt += 1
                        delay = min(5 * (2 ** (attempt % 10)), 300)
                        logger.warning(f"تلاش مجدد برای ربات {bot_name} پس از {delay} ثانیه...")
                        await asyncio.sleep(delay)
                        
                        data = load_user_data()
                        bot_info_check = data.get("users", {}).get(user_id, {}).get("bots", {}).get(bot_name)
                        if not bot_info_check or not bot_info_check.get("active"):
                            logger.warning(f"ربات {bot_name} غیرفعال شده، متوقف شد.")
                            break
                        expiry = bot_info_check.get("rental_expiry")
                        if expiry is not None and expiry != float('inf') and time() > expiry:
                            logger.warning(f"زمان ربات {bot_name} تموم شده، متوقف شد.")
                            break

                if bot_name in self.bot_tasks:
                    del self.bot_tasks[bot_name]
            
            task = asyncio.create_task(run_bot_with_reconnect())
            self.bot_tasks[bot_name] = task
            logger.info(f"ربات {bot_name} با موفقیت راه‌اندازی شد.")
            
        except Exception as e:
            logger.error(f"❌ خطا در راه‌اندازی ربات {bot_name}: {e}", exc_info=True)

