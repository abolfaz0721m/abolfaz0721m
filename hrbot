        user_data = get_user_data(user_id, data)
        if bot_name not in user_data.get("bots", {}):
            await self.highrise.chat(f"❌ ربات **{bot_name}** یافت نشد!")
            return
        
        bot_info = user_data["bots"][bot_name]
        expiry = bot_info.get("rental_expiry")
        
        if expiry is not None and expiry != float('inf'):
            remaining = expiry - time()
            if remaining <= 0:
                await self.highrise.chat(f"⏰ زمان ربات **{bot_name}** به پایان رسیده است!\nلطفاً با !pay یا !buy تمدید کنید.")
                return
        
