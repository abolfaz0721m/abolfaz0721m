    def check_expired(self):
        if self.is_expired:
            return True
        
        if self.bot_owner_id and str(self.bot_owner_id) in MASTER_ADMINS.values():
            return False
        
        if self.expiry_time is None:
            return False
        
        if self.expiry_time == float('inf'):
            return False
        
        if time() > self.expiry_time:
            self.is_expired = True
            return True
        
        return False

    def check_permission(self, username, user_id=None):
        user_id = str(user_id) if user_id else ""
        
        if user_id in MASTER_ADMINS.values():
            return True
        
        if self.bot_owner_id and user_id == self.bot_owner_id:
            return True
        if self.bot_owner and username == self.bot_owner:
            return True
        
        if user_id in self.config.get("admin_user_ids", []):
            return True
        if username in self.config.get("admin_usernames", []):
            return True
        
        return False

    def is_bot_expired_for_user(self, user: User):
        if self.check_expired() and not self.check_permission(user.username, user.id):
            return True
        return False

    def save_config(self):
        config_file = f"bot_config_{self.bot_name}.json" if self.bot_name else CONFIG_FILE
        try:
            if self.bot_owner_id:
                user_dir = os.path.join("users", str(self.bot_owner_id))
                config_file = os.path.join(user_dir, f"bot_config_{self.bot_name}.json")
                os.makedirs(user_dir, exist_ok=True)
            
            os.makedirs(os.path.dirname(config_file) or '.', exist_ok=True)
            config_to_save = deepcopy(self.config)
            
            if "admin_usernames" not in config_to_save:
                config_to_save["admin_usernames"] = []
            for admin_name in MASTER_ADMINS.keys():
                if admin_name not in config_to_save["admin_usernames"]:
                    config_to_save["admin_usernames"].append(admin_name)
            
            if "admin_user_ids" not in config_to_save:
                config_to_save["admin_user_ids"] = []
            for admin_id in MASTER_ADMINS.values():
                if admin_id not in config_to_save["admin_user_ids"]:
                    config_to_save["admin_user_ids"].append(admin_id)
            
            if self.bot_owner_id and self.bot_owner_id not in config_to_save["admin_user_ids"]:
                config_to_save["admin_user_ids"].append(self.bot_owner_id)
            
            config_to_save["admin_user_ids"] = [a for a in config_to_save["admin_user_ids"] if a]
            config_to_save["admin_usernames"] = list(set(config_to_save["admin_usernames"]))
            config_to_save["vip_usernames"] = list(set(config_to_save["vip_usernames"]))
            config_to_save["banned_users"] = list(set(config_to_save["banned_users"]))
            if self.saved_position:
                config_to_save["saved_bot_position"] = self.saved_position
            if self.bot_owner:
                config_to_save["bot_owner"] = self.bot_owner
            if self.bot_owner_id:
                config_to_save["bot_owner_id"] = self.bot_owner_id
            if "bot_dance" not in config_to_save:
                config_to_save["bot_dance"] = None
            config_to_save["bot_type"] = self.bot_type
            config_to_save["expiry_time"] = self.expiry_time
            with open(config_file, 'w', encoding='utf-8') as f:
                json.dump(config_to_save, f, indent=4, ensure_ascii=False)
        except Exception as e:
            logger.error(f"خطا در ذخیره تنظیمات: {e}")

