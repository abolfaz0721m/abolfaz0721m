        bot_name = " ".join(parts[1:])
        
        data = load_user_data()
        user_id = str(self.bot_owner_id) if self.bot_owner_id else None
        if not user_id:
            await self.highrise.chat("❌ شناسه مالک ربات یافت نشد!")
