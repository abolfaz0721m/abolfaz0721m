            return
        
        target_username = parts[1].lstrip('@').lower()
        target_user = self.active_users.get(target_username)
        if not target_user:
            await self.highrise.chat(self.get_message("user_not_found", username=target_username))
            return
        
        if target_user.id == user.id:
            await self.highrise.chat("❌ نمی‌توانید خودتان را دنبال کنید!")
            return
        
        follower_id = str(user.id)
        target_id = str(target_user.id)
        
        if follower_id in self.follow_targets:
            for existing_target in self.follow_targets[follower_id]["targets"]:
                if existing_target["target_id"] == target_id:
                    await self.highrise.chat(f"@{target_user.username} قبلاً توسط شما دنبال می‌شود!")
                    return
        
        follower_pos = self.user_positions.get(user.username.lower())
        if not follower_pos or not hasattr(follower_pos, 'x'):
            await self.highrise.chat("❌ موقعیت شما یافت نشد!")
            return
        
        try:
            await self.highrise.teleport(user_id=target_user.id, dest=follower_pos)
        except Exception as e:
            await self.highrise.chat(f"❌ خطا در تلپورت اولیه: {str(e)}")
            return
        
        if follower_id not in self.follow_targets:
            self.follow_targets[follower_id] = {
                "targets": [],
                "task": None,
                "follower_user": user
            }
        
        self.follow_targets[follower_id]["targets"].append({
            "target_id": target_id,
            "target_user": target_user,
            "target_username": target_username
        })
        
        if self.follow_targets[follower_id]["task"] is None or self.follow_targets[follower_id]["task"].done():
            async def follow_me_loop():
                while True:
                    try:
                        follower_id_local = str(user.id)
                        if follower_id_local not in self.follow_targets:
                            break
                        
                        follower_user = self.follow_targets[follower_id_local]["follower_user"]
                        
                        if follower_user.username.lower() not in self.active_users:
                            break
                        
                        follower_pos_new = self.user_positions.get(follower_user.username.lower())
                        if follower_pos_new and hasattr(follower_pos_new, 'x'):
                            for target_data in self.follow_targets[follower_id_local]["targets"][:]:
                                target_username_local = target_data["target_username"]
                                target_id_local = target_data["target_id"]
                                
                                if target_username_local not in self.active_users:
                                    self.follow_targets[follower_id_local]["targets"].remove(target_data)
                                    continue
                                
                                target_pos = self.user_positions.get(target_username_local)
                                
                                if target_pos and hasattr(target_pos, 'x'):
                                    if (target_pos.x != follower_pos_new.x or 
                                        target_pos.y != follower_pos_new.y or 
                                        target_pos.z != follower_pos_new.z):
                                        try:
                                            await self.highrise.teleport(user_id=target_id_local, dest=follower_pos_new)
                                        except Exception as e:
                                            logger.error(f"خطا در برگرداندن {target_username_local}: {e}")
                                else:
                                    try:
                                        await self.highrise.teleport(user_id=target_id_local, dest=follower_pos_new)
                                    except Exception as e:
                                        logger.error(f"خطا در تلپورت {target_username_local}: {e}")
                        
                        if not self.follow_targets[follower_id_local]["targets"]:
                            break
                        
                        await sleep(0.3)
                    except asyncio.CancelledError:
                        break
                    except Exception as e:
                        logger.error(f"خطا در حلقه دنبال‌کننده: {e}")
                        await sleep(2)
            
            task = create_task(follow_me_loop())
            self.follow_targets[follower_id]["task"] = task
        
        await self.highrise.chat(self.get_message("follow_me_success", target=target_user.username, follower=user.username))

