class MainBot(BaseBot):
    def __init__(self):
        super().__init__()
        self.user_id = None
        self.user_data = load_user_data()
        self.active_bots = {}
        self.restart_check_task = None

    async def on_start(self, session_metadata):
        self.user_id = getattr(session_metadata, "user_id", None)
        logger.info("ربات اصلی شروع به کار کرد.")
        try:
            await self.highrise.chat("✅ ربات آنلاین شد! در پیوی !help بزنید.")
        except:
            pass
        
        await self.start_saved_bots()
        self.restart_check_task = create_task(self.restart_check_loop())

    async def restart_check_loop(self):
        while True:
            try:
                await asyncio.sleep(30)
                data = load_user_data()
                for user_id, user_data in data.get("users", {}).items():
                    for bot_name, bot_info in user_data.get("bots", {}).items():
                        if bot_info.get("active", False) and bot_name not in self.active_bots:
                            expiry = bot_info.get("rental_expiry")
                            if expiry is None:
                                continue
                            if expiry == float('inf') or time() < expiry:
                                logger.info(f"ربات {bot_name} در active_bots نیست ولی زمان دارد. راه‌اندازی مجدد...")
                                await self.launch_bot(user_id, bot_name, bot_info)
            except asyncio.CancelledError:
                break
            except Exception as e:
                logger.error(f"خطا در حلقه بررسی راه‌اندازی مجدد: {e}", exc_info=True)
                await asyncio.sleep(60)

    async def start_saved_bots(self):
        data = load_user_data()
        logger.info("شروع ربات‌های ذخیره شده...")
        for user_id, user_data in data.get("users", {}).items():
            for bot_name, bot_info in user_data.get("bots", {}).items():
                if bot_info.get("active") and bot_info.get("rental_expiry"):
                    if bot_info["rental_expiry"] != float('inf') and time() > bot_info["rental_expiry"]:
                        bot_info["active"] = False
                        save_user_data(data)
                        logger.warning(f"ربات {bot_name} منقضی شده، غیرفعال شد.")
                        continue
                    logger.info(f"در حال راه‌اندازی ربات {bot_name} برای کاربر {user_id}")
                    await self.launch_bot(user_id, bot_name, bot_info)
        save_user_data(data)

    async def launch_bot(self, user_id: str, bot_name: str, bot_info: dict):
        if bot_name in self.active_bots:
            logger.info(f"ربات {bot_name} در حال اجراست، از راه‌اندازی مجدد خودداری شد.")
            return
        
        try:
            room_id = bot_info.get("room_id", "")
            api_token = bot_info.get("api_token", "")
            bot_type = bot_info.get("bot_type", "classic")
            
            logger.info(f"📋 اطلاعات ربات {bot_name}: room_id={room_id}, bot_type={bot_type}")
            
            if not room_id or not api_token:
                logger.error(f"❌ اطلاعات ربات {bot_name} برای کاربر {user_id} ناقصه")
                return
            
            logger.info(f"ساخت شیء ربات برای {bot_name} (کاربر {user_id}) با نوع {bot_type}")
            
            if bot_type == "game":
                advanced_bot = AdvancedBot(user_id=user_id, bot_type="game")
                logger.info(f"✅ ربات Game ساخته شد: {bot_name}")
            elif bot_type == "ai":
                advanced_bot = AIBot(user_id=user_id, bot_type="ai")
                logger.info(f"✅ ربات AI ساخته شد: {bot_name}")
            else:
                advanced_bot = AdvancedBot(user_id=user_id, bot_type="classic")
                logger.info(f"✅ ربات Classic ساخته شد: {bot_name}")
            
            advanced_bot.bot_name = bot_name
            advanced_bot.load_config()
            
            advanced_bot.bot_type = bot_type
            advanced_bot.config["bot_type"] = bot_type
            advanced_bot.save_config()
            
            if hasattr(advanced_bot, 'load_commands_by_type'):
                advanced_bot.load_commands_by_type()
                logger.info(f"✅ دستورات برای {bot_name} بارگذاری شد")
            
            if "owner" in bot_info and bot_info["owner"]:
                advanced_bot.bot_owner = bot_info["owner"]
            if "owner_id" in bot_info and bot_info["owner_id"]:
                advanced_bot.bot_owner_id = bot_info["owner_id"]
                advanced_bot.save_config()
                logger.info(f"👤 اجرای ربات {bot_name} برای کاربر {user_id} (مالک: {bot_info.get('owner', 'unknown')})")
            
            expiry = bot_info.get("rental_expiry")
            if expiry is not None:
                advanced_bot.expiry_time = expiry
                advanced_bot.save_config()
            
            bot_def = BotDefinition(advanced_bot, room_id, api_token)
            
            async def run_bot_with_reconnect():
                logger.info(f"🚀 شروع اجرای ربات {bot_name} با room_id={room_id} و نوع {bot_type}")
                attempt = 0
                while True:
                    try:
                        await highrise_main([bot_def])
                        logger.warning(f"⚠️ ربات {bot_name} بدون خطا قطع شد.")
                        
                        data = load_user_data()
                        bot_info_check = data.get("users", {}).get(user_id, {}).get("bots", {}).get(bot_name)
                        if not bot_info_check or not bot_info_check.get("active"):
                            logger.warning(f"ربات {bot_name} غیرفعال شده، متوقف شد.")
                            break
                        expiry = bot_info_check.get("rental_expiry")
                        if expiry is not None and expiry != float('inf') and time() > expiry:
                            logger.warning(f"زمان ربات {bot_name} تموم شده، متوقف شد.")
                            break
                        
                        attempt = 0
                        await asyncio.sleep(3)
                        continue
                        
                    except RestartBotException:
                        logger.info(f"🔄 ربات {bot_name} درخواست ری‌استارت داد.")
                        attempt = 0
                        continue
                    except Exception as e:
                        logger.error(f"❌ ربات {bot_name} با خطا متوقف شد: {e}", exc_info=True)
                        attempt += 1
                        delay = min(5 * (2 ** (attempt % 10)), 300)
                        logger.warning(f"تلاش مجدد برای ربات {bot_name} پس از {delay} ثانیه...")
                        await asyncio.sleep(delay)
                        
                        data = load_user_data()
                        bot_info_check = data.get("users", {}).get(user_id, {}).get("bots", {}).get(bot_name)
                        if not bot_info_check or not bot_info_check.get("active"):
                            logger.warning(f"ربات {bot_name} غیرفعال شده، متوقف شد.")
                            break
                        expiry = bot_info_check.get("rental_expiry")
                        if expiry is not None and expiry != float('inf') and time() > expiry:
                            logger.warning(f"زمان ربات {bot_name} تموم شده، متوقف شد.")
                            break
                
                if bot_name in self.active_bots:
                    del self.active_bots[bot_name]
            
            task = asyncio.create_task(run_bot_with_reconnect())
            self.active_bots[bot_name] = task
            logger.info(f"ربات {bot_name} با موفقیت به active_bots اضافه شد.")
            
            expiry = bot_info.get("rental_expiry")
            if expiry and expiry != float('inf'):
                remaining = expiry - time()
                if remaining > 0:
                    async def auto_stop():
                        await asyncio.sleep(remaining)
                        await self.stop_bot(bot_name)
                        logger.info(f"ربات {bot_name} به دلیل پایان زمان به طور خودکار متوقف شد.")
                    
                    asyncio.create_task(auto_stop())
            
        except Exception as e:
            logger.error(f"❌ خطا در اجرای ربات {bot_name}: {e}", exc_info=True)

    async def stop_bot(self, bot_name: str):
        if bot_name in self.active_bots:
            task = self.active_bots[bot_name]
            task.cancel()
            del self.active_bots[bot_name]
            logger.info(f"ربات {bot_name} متوقف شد.")

