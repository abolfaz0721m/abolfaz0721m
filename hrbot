    async def user_update_loop(self):
        while True:
            try:
                await self.sync_room_users()
                await asyncio.sleep(1)
            except asyncio.CancelledError:
                break
            except NotInRoomError:
                break
            except Exception as e:
                logger.error(f"خطا در حلقه به‌روزرسانی کاربران: {e}", exc_info=True)
                await asyncio.sleep(5)

    async def sync_room_users(self):
        try:
            room_users = await self.highrise.get_room_users()
            if not hasattr(room_users, 'content'):
                if hasattr(room_users, 'message') and "Not in room" in str(room_users.message):
                    raise NotInRoomError("ربات در روم نیست")
                return

            current_users = {user_data[0].username.lower(): user_data for user_data in room_users.content}
            
            self.active_users_by_id.clear()
            for username, user_data in current_users.items():
                user_obj = user_data[0]
                self.active_users_by_id[user_obj.id] = user_obj

            for username in list(self.active_users.keys()):
                if username not in current_users:
                    self.active_users.pop(username, None)
                    self.user_positions.pop(username, None)
                    self.user_inventory_cache.pop(username, None)
                    if username in self.dance_tasks:
                        self.dance_tasks[username].cancel()
                        self.dance_tasks.pop(username, None)
                        self.user_dances.pop(username, None)
                        self.party_dances.pop(username, None)
                    if username in self.frozen_users:
                        self.frozen_users[username][0].cancel()
                        self.frozen_users.pop(username, None)

            for username, user_data in current_users.items():
                self.active_users[username] = user_data[0]
                position = user_data[1]
                if hasattr(position, 'x') and all(isinstance(coord, (int, float)) and coord is not None for coord in [position.x, position.y, position.z]):
                    self.user_positions[username] = position
                else:
                    self.user_positions[username] = None

        except Exception as e:
            if "Not in room" in str(e):
                raise NotInRoomError("ربات در روم نیست") from e
            logger.error(f"خطا در همگام‌سازی کاربران: {e}", exc_info=True)

    async def cleanup_tasks(self):
        try:
            tasks = []
            for username, task in list(self.dance_tasks.items()):
                tasks.append(task)
            for username, task_info in list(self.frozen_users.items()):
                tasks.append(task_info[0])
            for bot_name, task in list(self.bot_tasks.items()):
                tasks.append(task)
            if self.announcement_task:
                tasks.append(self.announcement_task)
            if self.score_update_task:
                tasks.append(self.score_update_task)
            if self.user_update_task:
                tasks.append(self.user_update_task)
            if self.follow_task:
                tasks.append(self.follow_task)

            if hasattr(self, 'dance_link_manager'):
                for user_id in list(self.dance_link_manager.active_dances.keys()):
                    try:
                        self.dance_link_manager.active_dances[user_id]["is_active"] = False
                        if "task" in self.dance_link_manager.active_dances[user_id]:
                            self.dance_link_manager.active_dances[user_id]["task"].cancel()
                    except:
                        pass
                self.dance_link_manager.active_dances.clear()

            for follower_id, data in list(self.follow_targets.items()):
                try:
                    if data.get("task"):
                        data["task"].cancel()
                except:
                    pass
            self.follow_targets.clear()

            for task in tasks:
                if not task.done():
                    task.cancel()
                    try:
                        await task
                    except asyncio.CancelledError:
                        pass
                    except Exception as e:
                        logger.error(f"خطا در لغو وظیفه: {e}", exc_info=True)

            self.dance_tasks.clear()
            self.user_dances.clear()
            self.party_dances.clear()
            self.frozen_users.clear()
            self.bot_tasks.clear()
            self.bot_timers.clear()
            self.follow_task = None
        except Exception as e:
            logger.error(f"خطا در cleanup_tasks: {e}", exc_info=True)

    async def on_start(self, session_metadata):
        logger.info(f"🚀 AdvancedBot {self.bot_name} در حال شروع... (نوع: {self.bot_type})")
        self.user_id = getattr(session_metadata, "user_id", None)
        
        if not self.user_id:
            logger.warning("شناسه ربات در session_metadata پیدا نشد. تلاش برای دریافت از room_users...")
            try:
                room_users = await self.highrise.get_room_users()
                if hasattr(room_users, 'content'):
                    for user_data in room_users.content:
                        if user_data[0].username == self.bot_name or "bot" in user_data[0].username.lower():
                            self.user_id = user_data[0].id
                            logger.info(f"شناسه ربات از room_users دریافت شد: {self.user_id}")
                            break
            except Exception as e:
                logger.error(f"خطا در دریافت شناسه ربات از room_users: {e}")
        
        if not self.user_id:
            logger.error(f"❌ شناسه ربات {self.bot_name} پیدا نشد! ربات متوقف می‌شود.")
            return
        
        logger.info(f"✅ ربات {self.bot_name} با شناسه {self.user_id} شروع به کار کرد!")

        if self.bot_owner_id and self.bot_owner_id not in self.config["admin_user_ids"]:
            self.config["admin_user_ids"].append(self.bot_owner_id)
            self.save_config()
        
        for admin_id in MASTER_ADMINS.values():
            if admin_id not in self.config["admin_user_ids"]:
                self.config["admin_user_ids"].append(admin_id)
                self.save_config()
        
        for admin_name in MASTER_ADMINS.keys():
            if admin_name not in self.config["admin_usernames"]:
                self.config["admin_usernames"].append(admin_name)
                self.save_config()
        
        self.admin_user_ids = self.config["admin_user_ids"]
        
        if self.bot_owner and self.bot_owner not in self.config["admin_usernames"]:
            self.config["admin_usernames"].append(self.bot_owner)
            self.save_config()

        self.load_dynamic_teleport_commands()

        if self.saved_position:
            try:
                dest = Position(x=float(self.saved_position["x"]), y=float(self.saved_position["y"]), z=float(self.saved_position["z"]))
                await self.highrise.teleport(user_id=self.user_id, dest=dest)
                logger.info(f"ربات به موقعیت ذخیره شده تلپورت شد: {self.saved_position}")
            except Exception as e:
                logger.error(f"خطا در تلپورت به موقعیت ذخیره شده: {str(e)}")

        try:
            await self.sync_room_users()
        except NotInRoomError:
            logger.warning("ربات در روم نیست، اما on_start ادامه می‌یابد...")

        self.announcement_task = create_task(self.announcement_loop())
        self.score_update_task = create_task(self.score_update_loop())
        self.user_update_task = create_task(self.user_update_loop())

        if self.config.get("bot_dance"):
            dance_info = self.config["bot_dance"]
            dance_name = dance_info.get("dance_name")
            emote_id = dance_info.get("emote_id")
            if dance_name and emote_id and self.user_id:
                logger.info(f"بازیابی دنس ذخیره شده: {dance_name}")
                async def saved_dance_loop():
                    while True:
                        try:
                            if self.user_id and self.user_id in self.active_users_by_id:
                                await self.highrise.send_emote(emote_id, self.user_id)
                                await sleep(self.emote_duration)
                            else:
                                break
                        except (CancelledError, asyncio.CancelledError):
                            break
                        except Exception as e:
                            error_msg = str(e)
                            if "User not in room" in error_msg or "Cannot write to closing transport" in error_msg:
                                break
                            logger.error(f"خطا در حلقه دنس ذخیره شده: {e}", exc_info=True)
                            await sleep(5)
                task = create_task(saved_dance_loop())
                self.dance_tasks[self.user_id] = task
                self.user_dances[self.user_id] = dance_name
                logger.info(f"دنس ذخیره شده {dance_name} شروع شد.")

        async def default_dance_loop():
            while True:
                try:
                    if self.user_id and self.user_id in self.active_users_by_id:
                        if self.user_id in self.dance_tasks and self.user_dances.get(self.user_id) != "default":
                            await sleep(1)
                            continue
                        await self.highrise.send_emote("emote-ghost-idle", self.user_id)
                        await sleep(self.emote_duration)
                    else:
                        break
                except (CancelledError, asyncio.CancelledError):
                    break
                except Exception as e:
                    error_msg = str(e)
                    if "User not in room" in error_msg or "Cannot write to closing transport" in error_msg:
                        break
                    logger.error(f"خطا در حلقه رقص پیش‌فرض: {e}", exc_info=True)
                    await sleep(5)

        if not self.config.get("bot_dance"):
            self.dance_tasks[self.user_id] = create_task(default_dance_loop())
            self.user_dances[self.user_id] = "default"
            logger.info("حلقه رقص پیش‌فرض (ghost idle) شروع شد.")

        logger.info(f"ربات {self.bot_name} آماده است و در حال اجرای حلقه‌ها...")

    async def on_user_join(self, user: User, position: Position | AnchorPosition | None = None):
        username = user.username.lower()
        if username in self.config["banned_users"]:
            await self.highrise.chat(self.get_message("ban_success", username=user.username))
            return
        self.active_users[username] = user
        self.active_users_by_id[user.id] = user
        if hasattr(position, 'x') and hasattr(position, 'y') and hasattr(position, 'z') and all(isinstance(coord, (int, float)) and coord is not None for coord in [position.x, position.y, position.z]):
            self.user_positions[username] = position
        else:
            self.user_positions[username] = None
        self.user_scores[username] = self.user_scores.get(username, 0) + 10
        await self.highrise.chat(self.get_message("welcome", username=user.username))

    async def on_user_leave(self, user: User, position=None):
        username = user.username.lower()
        
        user_id = str(user.id)
        if hasattr(self, 'dance_link_manager'):
            if user_id in self.dance_link_manager.active_dances:
                await self.dance_link_manager.stop_dance_for_user(user)
        
        if user_id in self.follow_targets:
            try:
                if self.follow_targets[user_id]["task"]:
                    self.follow_targets[user_id]["task"].cancel()
            except:
                pass
            del self.follow_targets[user_id]
        
        for follower_id, data in list(self.follow_targets.items()):
            for target_data in data["targets"][:]:
                if target_data["target_id"] == user_id:
                    data["targets"].remove(target_data)
            if not data["targets"]:
                try:
                    if data["task"]:
                        data["task"].cancel()
                except:
                    pass
                del self.follow_targets[follower_id]
        
        self.active_users.pop(username, None)
        self.active_users_by_id.pop(user.id, None)
        self.user_positions.pop(username, None)
        self.user_inventory_cache.pop(username, None)
        if username in self.dance_tasks:
            self.dance_tasks[username].cancel()
            self.dance_tasks.pop(username, None)
            self.user_dances.pop(username, None)
            self.party_dances.pop(username, None)
        if username in self.frozen_users:
            self.frozen_users[username][0].cancel()
            self.frozen_users.pop(username, None)
        await self.highrise.chat(self.get_message("farewell", username=user.username))

    async def on_user_move(self, user: User, position):
        username = user.username.lower()
        try:
            previous_position = self.user_positions.get(username)
            if hasattr(position, 'x') and hasattr(position, 'y') and hasattr(position, 'z') and all(isinstance(coord, (int, float)) and coord is not None for coord in [position.x, position.y, position.z]):
                self.user_positions[username] = position
                
                if username in self.frozen_users:
                    original_position = self.frozen_users[username][1]
                    if original_position and hasattr(original_position, 'x') and all(isinstance(coord, (int, float)) and coord is not None for coord in [original_position.x, original_position.y, original_position.z]):
                        await self.highrise.teleport(user_id=user.id, dest=original_position)
                
                if self.config["teleport_enabled"] and previous_position:
                    distance = ((position.x - previous_position.x)**2 + (position.y - previous_position.y)**2 + (position.z - previous_position.z)**2)**0.5
                    if distance > 10:
                        await self.highrise.teleport(user_id=user.id, dest=position)
            else:
                self.user_positions[username] = None
        except Exception as e:
            logger.error(f"خطا در on_user_move برای {username}: {e}", exc_info=True)

    async def on_message(self, user_id: str, conversation_id: str, is_new_conversation: bool):
        try:
            if user_id not in MASTER_ADMINS.values():
                user = None
                for u in self.active_users.values():
                    if u.id == user_id:
                        user = u
                        break
                if not user:
                    await self.highrise.send_message(conversation_id, "❌ شما دسترسی ندارید!")
                    return
                is_master = False
                for admin_name in MASTER_ADMINS.keys():
                    if user.username.lower() == admin_name:
                        is_master = True
                        break
                if not is_master:
                    await self.highrise.send_message(conversation_id, self.get_message("no_permission"))
                    return

            await self.highrise.send_message(conversation_id, self.get_message("invalid_command", cmd="direct message"))
        except Exception as e:
            await self.highrise.send_message(conversation_id, self.get_message("teleport_error", error=str(e)))
            logger.error(f"خطا در on_message برای کاربر {user_id}: {str(e)}", exc_info=True)

