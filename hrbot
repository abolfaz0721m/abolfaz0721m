            except Exception as e:
                logger.error(f"خطا در حلقه به‌روزرسانی امتیازات: {e}", exc_info=True)
                await sleep(10)

    async def start_dance(self, user: User, emote: str):
        if self.bot_type == "game":
            return
        
        if self.is_bot_expired_for_user(user):
            return
        
        username = user.username.lower()
        if username not in self.active_users:
            return
        try:
            await self.stop_dance(user)
            self.user_dances[username] = emote
            async def dance_loop():
                while True:
                    try:
                        if self.user_dances.get(username) == emote and username in self.active_users:
                            await self.highrise.send_emote(emote, user.id)
                            await sleep(self.emote_duration)
                        else:
                            break
                    except CancelledError:
                        break
                    except Exception as e:
                        logger.error(f"خطا در حلقه رقص برای {username}: {e}")
                        await sleep(5)
            task = create_task(dance_loop())
            self.dance_tasks[username] = task
        except Exception as e:
            logger.error(f"خطا در start_dance برای {username}: {e}", exc_info=True)

    async def stop_dance(self, user: User):
        username = user.username.lower()
        try:
            if username in self.party_dances and self.party_dances[username][1]:
                pass
            if username in self.dance_tasks:
                self.user_dances.pop(username, None)
                self.party_dances.pop(username, None)
                self.dance_tasks[username].cancel()
                self.dance_tasks.pop(username, None)
                await self.highrise.chat(f"🛑 رقص برای @{username} متوقف شد.")
            else:
                await self.highrise.chat(f"@{username} در حال رقص نیست.")
        except Exception as e:
            logger.error(f"خطا در stop_dance برای {username}: {e}", exc_info=True)

    async def on_chat(self, user: User, message: str):
        username = user.username.lower()
        user_id = str(user.id)
        msg = message.strip().lower()
        self.user_scores[username] = self.user_scores.get(username, 0) + 2

        try:
            if self.is_bot_expired_for_user(user):
                if self.bot_type == "classic":
                    allowed_commands = ["!loop", "!set", "!help", "!follow", "!unfollow", "!welcome", "!out"]
                    is_allowed = False
                    for cmd in allowed_commands:
                        if msg.startswith(cmd):
                            is_allowed = True
                            break
                    
                    if not is_allowed:
                        try:
                            await self.highrise.send_whisper(user.id, self.get_message("expired_whisper"))
                        except:
                            await self.highrise.chat(f"@{user.username} " + self.get_message("expired_whisper"))
                        return
                else:
                    if not msg.startswith("!help") and not msg.startswith("!bot"):
                        try:
                            await self.highrise.send_whisper(user.id, self.get_message("expired_whisper"))
                        except:
                            await self.highrise.chat(f"@{user.username} " + self.get_message("expired_whisper"))
                        return

            # ========== ربات Game ==========
            if self.bot_type == "game":
                allowed_game_commands = ["!bet", "!hit", "!stay", "!game", "!bot", "!help"]
                is_allowed_game = False
                for cmd in allowed_game_commands:
                    if msg.startswith(cmd):
                        is_allowed_game = True
                        break
                
                if not is_allowed_game:
                    return
                
                parts = msg.split()
                cmd_key = parts[0] if parts else ""
                
                if cmd_key in self.commands:
                    await self.commands[cmd_key](user, message)
                return

            # ========== ربات Classic ==========
            if self.bot_type == "classic" and "high.rs/item" in message.lower() and "type=emote" in message.lower():
                if self.blackjack_game.game_in_progress:
                    return
                
                dance_id = self.dance_link_manager.extract_dance_from_link(message)
                if dance_id:
                    if user_id in self.dance_link_manager.active_dances:
                        await self.dance_link_manager.stop_dance_for_user(user)
                    
                    await self.dance_link_manager.start_dance_for_user(user, dance_id)
                    return
            
            if msg == "stop":
                if self.bot_type == "classic":
                    if user_id in self.dance_link_manager.active_dances:
                        await self.dance_link_manager.stop_dance_for_user(user)
                    
                    if username in self.dance_tasks:
                        self.user_dances.pop(username, None)
                        self.party_dances.pop(username, None)
                        self.dance_tasks[username].cancel()
                        self.dance_tasks.pop(username, None)
                        await self.highrise.chat(f"🛑 رقص برای @{user.username} متوقف شد.")
                    elif user_id not in self.dance_link_manager.active_dances:
                        await self.highrise.chat(f"❌ @{user.username} شما در حال دنس نیستید!")
                return
            
            if self.bot_type == "classic" and msg in self.emotes and not msg.startswith("!"):
                if self.blackjack_game.game_in_progress:
                    return
                
                if user_id in self.dance_link_manager.active_dances:
                    await self.dance_link_manager.stop_dance_for_user(user)
                
                await self.start_dance(user, self.emotes[msg])
                return
            
            if msg.startswith("!"):
                parts = msg.split()
                
                if len(parts) >= 2:
                    if parts[0] == "!item" and parts[1] == "set":
                        cmd_key = "!item_set"
                    elif parts[0] == "!emote" and len(parts) >= 2:
                        if parts[1] == "list":
                            cmd_key = "!emote_list"
                        elif parts[1] == "bot":
                            cmd_key = "!emote_bot"
                        else:
                            cmd_key = None
                    elif parts[0] == "!follow" and len(parts) >= 2 and parts[1] == "me":
                        cmd_key = "!follow_me"
                    elif parts[0] == "!unfollow" and len(parts) >= 2 and parts[1] == "me":
                        cmd_key = "!unfollow_me"
                    elif parts[0] == "!tele" and len(parts) >= 2:
                        try:
                            if len(parts) >= 5 and parts[1].startswith("@"):
                                float(parts[2])
                                float(parts[3])
                                float(parts[4])
                                cmd_key = "!tele_xyz"
                            else:
                                cmd_key = "!tele"
                        except:
                            cmd_key = "!tele"
                    else:
                        cmd_key = parts[0] if parts[0] in self.commands else None
                else:
                    cmd_key = parts[0] if parts and parts[0] in self.commands else None
                
                if not cmd_key:
                    if not self.blackjack_game.game_in_progress:
                        await self.highrise.chat(self.get_message("invalid_command", cmd=parts[0] if parts else ""))
                    return
                
                admin_commands = [
                    "!spam", "!tele", "!set", "!item_set", "!tip", "!vip", "!vip1", "!dj", "!down",
                    "!ban", "!unban", "!dancechain", "!addtele", "!deltele", "!welcome", "!addadmin",
                    "!removeadmin", "!listadd", "!freeze", "!unfreeze", "!add", "!start", "!stop",
                    "!list_bot", "!del_bot", "!lan_en", "!lan_fa", "!mic", "!remic", "!follow",
                    "!unfollow", "!out", "!loop", "!tele_on", "!tele_off", "!punch", "!cut", "!kick",
                    "!restart", "!emote_bot", "!wallet", "!testdance", "!emote_list",
                    "!game", "!dancelist", "!retry", "!follow_me", "!unfollow_me", "!tele_xyz"
                ]
                
                if self.bot_type == "classic" and cmd_key in admin_commands:
                    if not self.check_permission(username, user_id):
                        if not self.blackjack_game.game_in_progress:
                            await self.highrise.chat(self.get_message("no_permission"))
                        return
                
                if self.blackjack_game.game_in_progress and cmd_key not in ["!bet", "!hit", "!stay"]:
                    return
                
                if cmd_key in self.commands:
                    await self.commands[cmd_key](user, message)
                elif cmd_key.startswith("!") and cmd_key[1:] in self.config.get("teleport_locations", {}):
                    location_name = cmd_key[1:]
                    await self.dynamic_teleport_command(user, location_name)
                else:
                    if not self.blackjack_game.game_in_progress:
                        await self.highrise.chat(self.get_message("invalid_command", cmd=cmd_key))
                    
        except Exception as e:
            logger.error(f"خطا در پردازش چت از {username}: {e}", exc_info=True)

    async def dynamic_teleport_command(self, user: User, location_name: str):
        if not self.check_permission(user.username, user.id):
            await self.highrise.chat(self.get_message("no_permission"))
            return
        try:
            dest_data = self.config["teleport_locations"].get(location_name)
            if not dest_data:
                await self.highrise.chat(self.get_message("deltele_not_found", location=location_name))
                return
            dest = Position(x=float(dest_data["x"]), y=float(dest_data["y"]), z=float(dest_data["z"]))
            await self.highrise.teleport(user_id=user.id, dest=dest)
            await self.highrise.chat(self.get_message("teleport_success", username=user.username, location=location_name.upper()))
        except Exception as e:
            await self.highrise.chat(self.get_message("teleport_error", error=str(e)))
            logger.error(f"خطا در تلپورت {user.username} به {location_name}: {e}")

    async def on_disconnect(self):
        logger.warning("اتصال ربات قطع شد. تلاش برای reconnect...")
        await self.cleanup_tasks()


