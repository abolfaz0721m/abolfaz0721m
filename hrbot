class DanceLinkManager:
    def __init__(self, bot_instance):
        self.bot = bot_instance
        self.active_dances = {}
        self.last_dance_time = {}
        self.dance_duration = 7.0
        
    def extract_dance_from_link(self, url: str) -> str:
        return extract_dance_id_from_link(url)
    
    async def start_dance_for_user(self, user: User, dance_id: str):
        user_id = str(user.id)
        
        if user_id in self.active_dances:
            await self.stop_dance_for_user(user)
        
        username = user.username.lower()
        if username in self.bot.dance_tasks:
            self.bot.user_dances.pop(username, None)
            self.bot.party_dances.pop(username, None)
            self.bot.dance_tasks[username].cancel()
            self.bot.dance_tasks.pop(username, None)
        
        task = asyncio.create_task(self._dance_loop(user, dance_id))
        self.active_dances[user_id] = {
            "task": task,
            "is_active": True,
            "user": user,
            "dance_id": dance_id,
            "start_time": time()
        }
        self.last_dance_time[user_id] = time()
        
        await self.bot.highrise.chat(f"🎵 @{user.username} دنس **{dance_id}** رو شروع کرد! 💃")
        
        try:
            await self.bot.highrise.react("heart", user.id)
        except:
            pass
        
        return True
    
    async def _dance_loop(self, user: User, dance_id: str):
        user_id = str(user.id)
        
        while True:
            try:
                if user_id not in self.active_dances:
                    break
                if not self.active_dances[user_id].get("is_active", False):
                    break
                
                if user.username.lower() not in self.bot.active_users:
                    await self.stop_dance_for_user(user)
                    break
                
                try:
                    await self.bot.highrise.send_emote(dance_id, user.id)
                    self.last_dance_time[user_id] = time()
                except Exception as e:
                    if "User not in room" in str(e) or "not in room" in str(e).lower():
                        await self.stop_dance_for_user(user)
                        break
                    logger.error(f"خطا در ارسال دنس به {user.username}: {e}")
                    await asyncio.sleep(1)
                    continue
                
                await asyncio.sleep(self.dance_duration)
                
            except asyncio.CancelledError:
                break
            except Exception as e:
                logger.error(f"خطا در حلقه دنس برای {user.username}: {e}", exc_info=True)
                await asyncio.sleep(1)
        
        if user_id in self.active_dances:
            del self.active_dances[user_id]
        if user_id in self.last_dance_time:
            del self.last_dance_time[user_id]
    
    async def stop_dance_for_user(self, user: User):
        user_id = str(user.id)
        
        if user_id in self.active_dances:
            self.active_dances[user_id]["is_active"] = False
            
            if "task" in self.active_dances[user_id]:
                try:
                    self.active_dances[user_id]["task"].cancel()
                except:
                    pass
            
            dance_id = self.active_dances[user_id].get("dance_id", "نامشخص")
            
            del self.active_dances[user_id]
            
            if user_id in self.last_dance_time:
                del self.last_dance_time[user_id]
            
            try:
                await self.bot.highrise.send_emote("idle-osh", user.id)
            except:
                pass
            
            await self.bot.highrise.chat(f"⏹️ دنس **{dance_id}** @{user.username} متوقف شد!")
            return True
        
        return False
    
    def is_user_dancing(self, user: User) -> bool:
        return str(user.id) in self.active_dances
    
    def get_active_dance_users(self):
        return [data["user"] for data in self.active_dances.values()]


